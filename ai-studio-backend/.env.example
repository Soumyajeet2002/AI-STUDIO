NODE_ENV=development

PORT=3000

API_PREFIX=api
API_VERSION=v1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=lifeos

DATABASE_SSL=false
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
# ==========================================
# Authentication
# ==========================================

AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=



# LLM provider credentials — set real values only in your local environment
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default model routing
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4.1-mini

# Provider timeouts
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=4096